{
  "name": "bookshelf",
  "version": "1.0.0",
  "private": true,
  "description": "Bookshelf — Personal Reading Tracker (Frontend Mentor Product Challenge)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify:code": "npm run typecheck && npm run lint && npm run test && npm run build",
    "verify:browser": "npm run test:e2e",
    "verify": "npm run verify:code"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "idb": "^8.0.2",
    "lucide-react": "^1.16.0",
    "next": "^15.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.2.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/postcss": "^4.1.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.14.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-config-next": "^15.3.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
